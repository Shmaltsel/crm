{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter frontend build",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.svitlo-znan.app/:path*"
    },
    {
      "source": "/info",
      "destination": "/info/index.html"
    },
    {
      "source": "/info/:path*",
      "destination": "/info/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
